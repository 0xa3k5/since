{
  "name": "gitsince",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Since monorepo: desktop app and website",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.js",
    "desktop": "pnpm --filter @gitsince/desktop start",
    "dist": "pnpm --filter @gitsince/desktop dist",
    "web": "pnpm --filter @gitsince/web dev",
    "web:build": "pnpm --filter @gitsince/web build",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @gitsince/desktop test:e2e",
    "bench": "pnpm --filter @gitsince/desktop bench",
    "release:beta": "node apps/desktop/scripts/release-beta.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/0xa3k5/since.git"
  },
  "packageManager": "pnpm@10.34.7"
}
