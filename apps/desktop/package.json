{
  "name": "@gitsince/desktop",
  "productName": "Since",
  "version": "0.1.2",
  "description": "A fast, keyboard-first Git client for macOS with a live commit graph",
  "main": "out/main/main.js",
  "license": "GPL-3.0-or-later",
  "updates": {
    "feed": "https://github.com/0xa3k5/since/releases/latest/download",
    "page": "https://github.com/0xa3k5/since/releases/latest"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.tools.json",
    "start": "node scripts/dev-app-name.js && node scripts/build.js --dev && electron .",
    "test": "pnpm run typecheck && node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"test/**/*.test.js\"",
    "test:e2e": "playwright test -c e2e",
    "dist": "node scripts/build.js && electron-builder --mac --config electron-builder.config.js --publish never",
    "brand-assets": "electron scripts/render-brand-assets.js",
    "bench": "node bench/bench.js",
    "bench:lanes": "node bench/lanes.js",
    "demo-video": "playwright test -c e2e/demo-video.config.js",
    "test:update": "node scripts/update-e2e.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "private": true
}
