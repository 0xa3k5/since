---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../guides/_Breadcrumbs.astro';
import { DOWNLOAD_URL, PRODUCT_NAME } from '../../config';
import { CHECKED, COMPETITORS, US } from './_data';
import { GUIDE_LIST } from '../guides/_list';
import '../guides/_content.css';

// The hub shows three rows from each page's own table, so the facts live in one place.
const pick = (label: string) => COMPETITORS.map((c) => {
  const r = c.rows.find((x) => x.label === label);
  if (!r) throw new Error(`${c.slug} has no "${label}" row`);
  return { c, r };
});
const ROWS = [
  { label: 'Price and model', us: US.price },
  { label: 'Platforms', us: US.platforms },
  { label: 'Undo of branch and history changes', us: US.undo },
].map((row) => ({ ...row, cells: pick(row.label) }));

const sources = COMPETITORS.flatMap((c) => c.sources.map((s) => ({ ...s, key: `${c.slug}-${s.id}` })));
const num = new Map(sources.map((s, i) => [s.key, i + 1]));
const checkedLabel = new Date(CHECKED + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base
  title={`Git clients for Mac compared · ${PRODUCT_NAME}`}
  description={`How ${PRODUCT_NAME} compares with Fork, Tower, GitKraken, Sublime Merge and Sourcetree on price, platforms and undo. Every fact sourced and dated.`}
  ogTheme="light"
>
  <section class="wrap page">
    <Breadcrumbs items={[{ href: '/compare', label: 'Compare' }]} />
    <header class="page-head">
      <p class="eyebrow">Compare</p>
      <h1>Git clients for Mac compared</h1>
      <p class="lede">Five popular Mac clients next to {PRODUCT_NAME}, on the things people ask about first: what it costs, where it runs and what you can undo. Each page goes deeper and says where the other app is the better choice.</p>
      <p class="checked">Checked on <time datetime={CHECKED}>{checkedLabel}</time>. <a href="#sources">See sources</a>.</p>
    </header>

    <section>
      <ul class="card-list">
        {COMPETITORS.map((c) => <li><a href={`/compare/${c.slug}`}><strong>{PRODUCT_NAME} vs {c.name}</strong><span>{c.intro.split('. ')[0]}.</span></a></li>)}
      </ul>
    </section>

    {ROWS.map((row) => (
      <section>
        <h2>{row.label}</h2>
        <div class="table-scroll" tabindex="0" role="region" aria-label={row.label}>
          <table class="compare wide">
            <tbody>
              <tr><th scope="row">{PRODUCT_NAME}</th><td>{row.us}</td></tr>
              {row.cells.map(({ c, r }) => (
                <tr>
                  <th scope="row"><a href={`/compare/${c.slug}`}>{c.name}</a></th>
                  <td>{r.them}{r.src.map((id) => <sup><a href={`#src-${c.slug}-${id}`} aria-label={`Source ${num.get(`${c.slug}-${id}`)}`}>[{num.get(`${c.slug}-${id}`)}]</a></sup>)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <section>
      <p class="cta-row">
        <a class="btn btn-primary" href={DOWNLOAD_URL}>Download free trial</a>
        <a class="btn btn-secondary" href="/pricing">See pricing</a>
      </p>
    </section>

    <section id="sources" class="sources">
      <h2>Sources</h2>
      <p class="muted">All accessed <time datetime={CHECKED}>{checkedLabel}</time>.</p>
      <ol>
        {sources.map((s) => <li id={`src-${s.key}`}>{s.title}: <a href={s.url} rel="nofollow noopener">{s.url}</a> <span class="muted">(accessed {CHECKED})</span></li>)}
      </ol>
      <p class="muted small">Product names are trademarks of their owners. {PRODUCT_NAME} is not affiliated with or endorsed by them.</p>
    </section>

    <nav class="related" aria-label="Related pages">
      <div>
        <h2>Guides</h2>
        <ul>{GUIDE_LIST.map((g) => <li><a href={g.href}>{g.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>{PRODUCT_NAME}</h2>
        <ul><li><a href="/features">Features</a></li><li><a href="/pricing">Pricing</a></li><li><a href="/shortcuts">Keyboard shortcuts</a></li></ul>
      </div>
    </nav>
  </section>
</Base>
