---
// Shared template for /compare/<competitor> (website plan §7.4). Not a route ("_" prefix).
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../guides/_Breadcrumbs.astro';
import { DOWNLOAD_URL, PRODUCT_NAME } from '../../config';
import { COMPETITORS, type Competitor } from './_data';
import { GUIDE_LIST } from '../guides/_list';
import '../guides/_content.css';

export interface Props { c: Competitor; ogTheme?: 'light' | 'dark' }
const { c, ogTheme = 'dark' } = Astro.props;

const srcIndex = new Map(c.sources.map((s, i) => [s.id, i + 1]));
const others = COMPETITORS.filter((x) => x.slug !== c.slug);
const checkedLabel = new Date(c.checked + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={c.title} description={c.description} ogTheme={ogTheme}>
  <article class="wrap page">
    <Breadcrumbs items={[{ href: '/compare', label: 'Compare' }, { href: `/compare/${c.slug}`, label: `${PRODUCT_NAME} vs ${c.name}` }]} />

    <header class="page-head">
      <p class="eyebrow">Comparison</p>
      <h1>{c.name} alternative for Mac: {PRODUCT_NAME} compared</h1>
      <p class="lede">{c.intro}</p>
      <p class="checked">Facts about {c.name} checked on <time datetime={c.checked}>{checkedLabel}</time>, with a source for each. <a href="#sources">See sources</a>.</p>
    </header>

    <section class="choose" aria-label="Summary">
      <div class="choose-card us">
        <h2>Choose {PRODUCT_NAME} if…</h2>
        <ul>{c.chooseUs.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="choose-card">
        <h2>Choose {c.name} if…</h2>
        <ul>{c.chooseThem.map((t) => <li>{t}</li>)}</ul>
      </div>
    </section>

    <section>
      <h2>Side by side</h2>
      <div class="table-scroll" tabindex="0" role="region" aria-label={`${PRODUCT_NAME} and ${c.name} compared`}>
        <table class="compare">
          <thead>
            <tr><th scope="col"><span class="sr-only">Feature</span></th><th scope="col">{PRODUCT_NAME}</th><th scope="col">{c.name}</th></tr>
          </thead>
          <tbody>
            {c.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.us}</td>
                <td>
                  {r.them}
                  {r.src.map((id) => <sup><a href={`#src-${id}`} aria-label={`Source ${srcIndex.get(id)}`}>[{srcIndex.get(id)}]</a></sup>)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">{PRODUCT_NAME} column: what the current version does. Features marked “Not yet” are not in the app today.</p>
    </section>

    <section>
      <h2>Three differences that matter</h2>
      <div class="diffs">
        {c.differences.map((d) => (
          <div class="diff">
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2>Where {c.name} is the better choice</h2>
      <ul class="prose-list">{c.betterChoice.map((t) => <li>{t}</li>)}</ul>
    </section>

    <section>
      <h2>Switching from {c.name}</h2>
      <ul class="prose-list">{c.switching.map((t) => <li set:html={t.replace(/`([^`]+)`/g, '<code>$1</code>')} />)}</ul>
      <p class="cta-row">
        <a class="btn btn-primary" href={DOWNLOAD_URL}>Download free trial</a>
        <a class="btn btn-secondary" href="/pricing">See pricing</a>
      </p>
    </section>

    <section id="sources" class="sources">
      <h2>Sources</h2>
      <p class="muted">All accessed <time datetime={c.checked}>{checkedLabel}</time>. “Unverified” marks a claim we could not confirm on the vendor’s own pages. Spot an error? <a href="/contact">Tell us</a> and we’ll fix it within a week.</p>
      <ol>
        {c.sources.map((s) => (
          <li id={`src-${s.id}`}>
            {s.title}: <a href={s.url} rel="nofollow noopener">{s.url}</a>{s.note && <span> {s.note}</span>} <span class="muted">(accessed {c.checked})</span>
          </li>
        ))}
      </ol>
      <p class="muted small">{c.name} is a trademark of its owner. {PRODUCT_NAME} is not affiliated with or endorsed by them. Names are used only to identify the products compared.</p>
    </section>

    <nav class="related" aria-label="Related pages">
      <div>
        <h2>Other comparisons</h2>
        <ul>
          <li><a href="/compare">All Mac Git clients compared</a></li>
          {others.map((o) => <li><a href={`/compare/${o.slug}`}>{PRODUCT_NAME} vs {o.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Guides</h2>
        <ul>{GUIDE_LIST.map((g) => <li><a href={g.href}>{g.label}</a></li>)}</ul>
      </div>
    </nav>
  </article>
</Base>
