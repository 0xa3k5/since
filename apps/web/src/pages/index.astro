---
// Landing page: the Git client for landing agents' work. Sections live in components/landing/.
import Base from '../layouts/Base.astro';
import Hero from '../components/landing/Hero.astro';
import Problem from '../components/landing/Problem.astro';
import Lanes from '../components/landing/Lanes.astro';
import CatchUp from '../components/landing/CatchUp.astro';
import Review from '../components/landing/Review.astro';
import SendBack from '../components/landing/SendBack.astro';
import MergePlan from '../components/landing/MergePlan.astro';
import GitClientTabs from '../components/landing/GitClientTabs.astro';
import Keyboard from '../components/landing/Keyboard.astro';
import Founder from '../components/landing/Founder.astro';
import Pricing from '../components/landing/Pricing.astro';
import Faq from '../components/landing/Faq.astro';
import Close from '../components/landing/Close.astro';
import { faqJsonLd } from '../components/landing/faq';
import { PRICE_NOW, PRODUCT_NAME } from '../config';
import '../components/landing/landing.css';

const title = `${PRODUCT_NAME}: a keyboard-first Git client for Mac`;
const description = `${PRODUCT_NAME} is the Git client for the agentic era. See what your agents landed, send back what's stuck, and merge the rest in order. Local-first Mac app, $${PRICE_NOW} once.`;
---
<Base title={title} description={description} ogImage="/og/home.png">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="lp">
    <Hero />
    <Problem />
    <Lanes />
    <CatchUp />
    <Review />
    <SendBack />
    <MergePlan />
    <GitClientTabs />
    <Keyboard />
    <Founder />
    <Pricing />
    <Faq />
    <Close />
  </div>
</Base>
