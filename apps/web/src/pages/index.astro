---
// Landing page (website plan §3, hero option A). Copy follows the claim gates in §3.6:
// only what is merged in `main` today. Gated lines and what unlocks them are listed beside each one.
import Base from '../layouts/Base.astro';
import Shot from '../components/landing/Shot.astro';
import PriceCard from '../components/landing/PriceCard.astro';
import { BUY_URL, DOWNLOAD_URL, PRICE_LATER, PRICE_NOW, PRODUCT_NAME } from '../config';
import mapLight from '../assets/landing/app-map-light.webp';
import mapDark from '../assets/landing/app-map-dark.webp';
import snapshotsLight from '../assets/landing/app-snapshots-light.webp';
import snapshotsDark from '../assets/landing/app-snapshots-dark.webp';
import keysLight from '../assets/landing/app-keys-light.webp';
import keysDark from '../assets/landing/app-keys-dark.webp';

const title = `${PRODUCT_NAME}: a keyboard-first Git client for Mac`;
const description = 'Work directly on your commit graph and undo any rebase, reset, merge or discard with ⌘Z. Keyboard-first, no account, one-time purchase. Try it free for 14 days.';

// Hero clip slot: the 20-second "wrong rebase → ⌘Z → back" clip (shot list in the PR).
// Set the four encodes to switch the hero from the screenshot to the clip; the screenshot becomes its poster.
type Clip = { light: { mp4: string; webm: string }; dark: { mp4: string; webm: string } };
const HERO_CLIP: Clip | null = null;

const features = [
  { title: 'Line-by-line staging', body: 'Stage a file, a hunk or a single line from the Commit view.' },
  { title: 'Rewrite from the graph', body: 'Squash, fixup, reword, split, reorder and drop commits in place.' },
  { title: 'Conflicts, step by step', body: 'A 3-way merge editor, plus Continue and Abort for what is in progress.' },
  { title: 'Stashes and reflog', body: 'Stash files, staged changes or single lines; see the reflog for every ref.' },
  { title: '⌘K command palette', body: 'Find any command by name, with its shortcut beside it.' },
  { title: 'Fetch, pull and push', body: 'Over your own remotes, with your own credentials.' },
  { title: 'Search commits', body: 'Press / or ⌘F to find a commit by message, author, branch or SHA.' },
  { title: 'Light and dark', body: 'Follows your system, or pick one with ⌃⌘T.' },
];

// Six questions from website plan §3.4, worded to match what ships today.
const faq = [
  {
    q: 'Is it really a one-time payment?',
    a: `Yes. You pay $${PRICE_NOW} once and get every future version of ${PRODUCT_NAME} for macOS. No renewals, no paid upgrades, no subscription. The launch price goes up to $${PRICE_LATER} later; if you buy now, you never pay again.`,
  },
  {
    q: 'What does the trial include?',
    a: 'Every feature, for 14 days. There is no account to create and no card to enter.',
  },
  {
    q: 'What exactly can ⌘Z undo?',
    a: 'Every operation that moves a branch, tag or HEAD, discards changes or drops a stash: rebase, merge, reset, cherry-pick, revert, pull, commit, squash, creating, renaming or deleting branches, creating or deleting tags, discarding files and dropping stashes. Redo with ⌘⇧Z. The history is kept in your repository, survives a restart, and has no step limit.',
  },
  {
    q: 'Does it use my git config, hooks and credentials?',
    a: `Yes. ${PRODUCT_NAME} runs the git installed on your Mac, so your config, hooks, aliases and credential helpers behave exactly as they do in the terminal.`,
  },
  {
    // Gate: no "no tracking" or "only calls home for X" claim about the app until the network audit (AK-48).
    q: 'Do I need an account?',
    a: `No. There is nothing to sign up for. When you buy, you get a licence key by email, and ${PRODUCT_NAME} checks it with our payment provider when you activate it.`,
  },
  {
    q: 'Is there a Windows or Linux version?',
    a: `No. ${PRODUCT_NAME} is a Mac app, for macOS 12 or later on Apple silicon and Intel.`,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base title={title} description={description} ogImage="/og/home.png">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- Stage: the app window is the star, lit from behind. -->
  <section class="stage hero">
    <div class="stage-glow" aria-hidden="true"></div>
    <div class="stage-dots" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <h1 class="display">Rebase without fear. <span class="nowrap"><kbd>⌘Z</kbd> undoes it.</span></h1>
      <p class="hero-sub">{PRODUCT_NAME} is a keyboard-first client for Git on the Mac. Work directly on your commit graph, and undo any rebase, reset, merge or discard with ⌘Z, even after you quit. Pay once. No account.</p>
      <div class="cta-row">
        <div class="cta">
          <a class="btn btn-primary btn-lg" href={DOWNLOAD_URL}>Download free trial</a>
          <p class="micro">14 days · every feature · no account<br>macOS 12 or later · Apple silicon &amp; Intel</p>
        </div>
        <div class="cta">
          <a class="btn btn-secondary btn-lg" href={BUY_URL}>Buy · ${PRICE_NOW}</a>
          <p class="micro">One-time launch price<br>Goes up to ${PRICE_LATER} later</p>
        </div>
      </div>
    </div>
    <div class="wrap hero-media">
      <div class="float-keys" aria-hidden="true">
        <span class="fk fk-z"><kbd class="keycap">⌘</kbd><kbd class="keycap">Z</kbd></span>
        <span class="fk fk-k"><kbd class="keycap">⌘</kbd><kbd class="keycap">K</kbd></span>
      </div>
      {HERO_CLIP ? (
        <div class="clip">
          {(['light', 'dark'] as const).map((t) => (
            <video class={`only-${t}`} muted loop playsinline preload="none" data-hero-clip
              poster={(t === 'light' ? mapLight : mapDark).src} aria-label="A rebase onto the wrong branch, undone with ⌘Z">
              <source src={HERO_CLIP[t].webm} type="video/webm" />
              <source src={HERO_CLIP[t].mp4} type="video/mp4" />
            </video>
          ))}
        </div>
      ) : (
        <Shot class="hero-shot" light={mapLight} dark={mapDark} eager widths={[720, 1080, 1440, 2160]} sizes="(max-width: 1120px) 100vw, 1072px"
          alt={`The ${PRODUCT_NAME} commit graph: branches and tags drawn as coloured lanes beside the commit list, with the selected commit's details on the right.`} />
      )}
    </div>
  </section>

  <div class="frame body">
    <section class="section rule-top tick idea" aria-labelledby="undo">
      <div class="split">
        <div class="copy" data-reveal>
          <p class="eyebrow">Undo</p>
          <h2 id="undo" class="h2">Every branch, tag and HEAD change can be undone.</h2>
          <p>Rebase, merge, reset, cherry-pick, delete a branch, discard a file, then press <kbd>⌘Z</kbd>. Step back through your recent operations and redo with <kbd>⌘⇧Z</kbd>.</p>
          <p>The history is saved with your repository, so it's still there after you quit. Undo a commit and its changes come back staged.</p>
        </div>
        <figure class="framed" data-reveal>
          <figcaption class="annot"><span>01</span> Undo</figcaption>
          <Shot light={snapshotsLight} dark={snapshotsDark} widths={[720, 1080, 1600, 2160]} sizes="(max-width: 900px) 100vw, 620px"
            alt="The Snapshots view listing recent operations, newest first: delete branch, rebase, create branch. Undo and Redo buttons sit at the top right." />
          <div class="toast" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16"><path d="M6 3.5L2.5 7 6 10.5M3 7h6.5a4 4 0 0 1 0 8H8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="bar" style="width: 88px"></span>
            <span class="keys"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>Z</kbd></span>
          </div>
        </figure>
      </div>
    </section>

    <section class="section rule-top tick idea" aria-labelledby="graph">
      <div class="split reverse">
        <div class="copy" data-reveal>
          <p class="eyebrow">Keyboard</p>
          <h2 id="graph" class="h2">Work on the graph, not around it.</h2>
          <p>Move with <kbd>↑</kbd> and <kbd>↓</kbd>. Press <kbd>s</kbd> to squash, <kbd>f</kbd> to fixup, <kbd>e</kbd> to reword, <kbd>r</kbd> to rebase, <kbd>m</kbd> to merge, <kbd>p</kbd> to cherry-pick.</p>
          <p>Every commit action is a single key. Commands are also in the <kbd>⌘K</kbd> palette, and the mouse works too.</p>
        </div>
        <figure class="framed narrow-shot" data-reveal>
          <figcaption class="annot"><span>02</span> Keyboard</figcaption>
          <Shot light={keysLight} dark={keysDark} widths={[480, 770, 1100]} sizes="(max-width: 900px) 100vw, 520px"
            alt="A commit's menu open on the graph, with a single-key shortcut beside each action: M merge, R rebase, P cherry-pick, V revert, E edit message, S squash, F fixup." />
        </figure>
      </div>
    </section>

    <section class="section rule-top tick idea" aria-labelledby="live">
      <div class="split">
        <div class="copy" data-reveal>
          <p class="eyebrow">Live</p>
          <h2 id="live" class="h2">It sees what your other tools do.</h2>
          <p>Commit from the terminal, switch branches in your editor, let a script rebase. {PRODUCT_NAME} picks up the change on disk and redraws the graph on its own, with nothing to refresh.</p>
        </div>
        <figure class="framed" data-reveal>
          <figcaption class="annot"><span>03</span> Live</figcaption>
          <div class="terminal" role="img" aria-label="A terminal running git commit and git switch; the graph updates without a refresh.">
            <div class="term-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <pre aria-hidden="true"><span class="p">$</span> git commit -am "Debounce search input"
[feature/search 928af37] Debounce search input
<span class="p">$</span> git switch main
Switched to branch 'main'
<span class="ok">● {PRODUCT_NAME} redrew the graph · 0 clicks</span></pre>
          </div>
        </figure>
      </div>
    </section>

    <section class="section rule-top tick" aria-labelledby="features">
      <div class="section-head" data-reveal>
        <h2 id="features" class="h2">Everything you reach for, one key away.</h2>
      </div>
      <ul class="bento" data-reveal>
        {features.map((f, i) => (
          <li class={`tile tile-${i}`}>
            {i === 1 && (
              <div class="vig vig-graph" aria-hidden="true">
                <svg class="lanes" viewBox="0 0 64 160" preserveAspectRatio="none">
                  <path d="M16 0V160" style="stroke: var(--lane-0)" />
                  <path d="M16 112C16 92 40 92 40 72V24C40 8 16 8 16 0" style="stroke: var(--lane-1)" />
                  <circle cx="16" cy="16" r="5" style="fill: var(--lane-0)" /><circle cx="40" cy="48" r="5" style="fill: var(--lane-1)" />
                  <circle cx="40" cy="80" r="5" style="fill: var(--lane-1)" /><circle cx="16" cy="112" r="5" style="fill: var(--lane-0)" />
                  <circle cx="16" cy="144" r="5" style="fill: var(--lane-0)" />
                </svg>
                <div class="rows">
                  <div class="row"><span class="sha">928af37</span><span class="bar" style="width: 52%"></span></div>
                  <div class="row is-sel"><span class="sha">4c1e0b2</span><span class="bar" style="width: 38%"></span><span class="keys"><kbd>S</kbd></span></div>
                  <div class="row"><span class="sha">b07d9a4</span><span class="bar" style="width: 60%"></span></div>
                  <div class="row"><span class="sha">e5f31c8</span><span class="bar" style="width: 44%"></span></div>
                  <div class="row"><span class="sha">1a9c6d0</span><span class="bar" style="width: 56%"></span></div>
                </div>
              </div>
            )}
            {i === 4 && (
              <div class="vig vig-palette" aria-hidden="true">
                <div class="pal-input"><kbd>⌘</kbd><kbd>K</kbd><span class="caret"></span></div>
                <div class="row is-sel"><span class="bar" style="width: 46%"></span><span class="keys"><kbd>S</kbd></span></div>
                <div class="row"><span class="bar" style="width: 34%"></span><span class="keys"><kbd>F</kbd></span></div>
                <div class="row"><span class="bar" style="width: 52%"></span><span class="keys"><kbd>E</kbd></span></div>
              </div>
            )}
            {i === 0 && (
              <div class="vig vig-diff" aria-hidden="true">
                <div class="dl del"><span>−</span><span class="bar" style="width: 62%"></span></div>
                <div class="dl add is-staged"><span>+</span><span class="bar" style="width: 70%"></span></div>
                <div class="dl add"><span>+</span><span class="bar" style="width: 48%"></span></div>
                <div class="dl"><span></span><span class="bar" style="width: 40%"></span></div>
              </div>
            )}
            <h3 class="h3">{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/features">See all features →</a></p>
    </section>

    <section class="rule-top tick duo" aria-labelledby="yourgit">
      <div class="section" data-reveal>
        <h2 id="yourgit" class="h2">Your git, your config.</h2>
        <p>{PRODUCT_NAME} runs the git already on your Mac, so behaviour matches the command line exactly: your hooks, aliases, credential helpers and config all just work.</p>
      </div>
      <div class="section" data-reveal>
        <h2 class="h2">No account to create.</h2>
        <p>Download it, open a repository, start working. There's nothing to sign up for, and your code goes only where your own remotes point. <a href="/privacy">How we handle data →</a></p>
      </div>
    </section>

    <section class="section rule-top tick" id="pricing" aria-labelledby="price">
      <div class="price-wrap">
        <div class="copy" data-reveal>
          <h2 id="price" class="h1">One price. Yours to keep.</h2>
          <p>Buy once and every future version for macOS is included. No renewals, no paid upgrades, no subscription.</p>
          <p class="muted">Try every feature free for 14 days first.</p>
        </div>
        <div data-reveal><PriceCard /></div>
      </div>
    </section>

    <section class="section rule-top tick faq-wrap" aria-labelledby="faq">
      <div class="faq-head">
        <h2 id="faq" class="h2">Questions</h2>
        <p class="more">More questions? <a href="/pricing#faq">Pricing FAQ</a> · <a href="/docs">Docs</a></p>
      </div>
      <div class="faq">
        {faq.map(({ q, a }) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <section class="stage final" aria-labelledby="try">
    <div class="stage-glow" aria-hidden="true"></div>
    <div class="wrap center" data-reveal>
      <h2 id="try" class="h1">Try it on your own repository.</h2>
      <p>14 days, every feature, nothing to sign up for. If you have a rebase coming up, it's a good time to try.</p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={DOWNLOAD_URL}>Download free trial</a>
        <a class="btn btn-secondary btn-lg" href={BUY_URL}>Buy · ${PRICE_NOW}</a>
      </div>
    </div>
  </section>
</Base>

{HERO_CLIP && (
  <script is:inline>
    // Autoplay the visible hero clip unless the reader prefers reduced motion; then show controls instead.
    (() => {
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('[data-hero-clip]').forEach((v) => {
        if (still) { v.controls = true; return; }
        if (v.offsetParent !== null) { v.preload = 'auto'; v.play().catch(() => { v.controls = true; }); }
      });
    })();
  </script>
)}

<style>
  /* ------------------------------------------------------------ Stage (hero + closing CTA) */
  .stage { position: relative; isolation: isolate; overflow: hidden; background: var(--stage); border-bottom: 1px solid var(--hairline); }
  .stage-glow {
    position: absolute; z-index: -1; left: 50%; top: 42%; width: min(1400px, 140vw); aspect-ratio: 2 / 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, var(--stage-glow), var(--stage-glow-2) 55%, transparent);
    filter: blur(20px); pointer-events: none;
    animation: glow-drift 18s var(--ease) infinite alternate;
  }
  @keyframes glow-drift {
    from { transform: translate(-52%, -50%) scale(1); }
    to { transform: translate(-48%, -46%) scale(1.08); }
  }
  .stage-dots {
    position: absolute; z-index: -1; inset: 0; pointer-events: none;
    background: radial-gradient(var(--grid-dot) 1px, transparent 1.5px) 0 0 / 24px 24px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000, transparent);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000, transparent);
  }

  .hero { padding-top: clamp(64px, 10vw, 120px); }
  .hero-inner { text-align: center; }
  .hero h1 { margin: 0 auto; max-width: 14ch; }
  .hero h1 kbd {
    font-family: var(--font); font-size: 0.72em; font-weight: 600; letter-spacing: -0.02em;
    height: 1.18em; padding: 0 0.22em; border-radius: 0.2em; vertical-align: 0.08em;
    color: var(--accent-fg);
  }
  .hero-sub { margin: 24px auto 0; max-width: 600px; font-size: var(--fs-md); line-height: 1.55; color: var(--text-3); }
  .cta-row { display: flex; justify-content: center; gap: 12px 16px; flex-wrap: wrap; margin-top: 36px; }
  .cta { display: grid; justify-items: center; gap: 12px; }
  .micro { margin: 0; font: 400 var(--fs-xs)/1.6 var(--mono); color: var(--text-3); }
  .hero-media { position: relative; margin-top: 64px; margin-bottom: -1px; }
  .hero-media :global(.hero-shot), .clip video {
    border-radius: var(--radius-xl) var(--radius-xl) 0 0; border-bottom: 0;
    box-shadow: var(--shot-shadow);
  }
  .clip video { display: block; width: 100%; height: auto; border: 1px solid var(--hairline); }

  .float-keys { position: absolute; inset: 0 var(--gutter); pointer-events: none; z-index: 1; }
  .fk { position: absolute; display: flex; gap: 6px; }
  .fk kbd { font-size: 20px; }
  .fk-z { left: -12px; top: 18%; transform: rotate(-6deg); }
  .fk-k { right: -12px; top: 46%; transform: rotate(5deg); }

  /* ------------------------------------------------------------ Editorial body */
  .body { margin-top: 0; }
  .body .section:first-child { border-top: 0; }
  .section p { color: var(--text-3); max-width: 60ch; }
  .copy { display: grid; gap: 0; align-content: center; }
  .copy .eyebrow { margin-bottom: 18px; }
  .copy h2 { margin-bottom: 18px; }
  .copy p { margin: 0 0 12px; }
  .center { text-align: center; }
  .center p { margin-left: auto; margin-right: auto; }

  .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 64px; align-items: center; }
  .split.reverse { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .split.reverse .copy { order: 2; }

  /* Framed product shots: a quiet card with a mono figure number. */
  .framed { position: relative; margin: 0; padding: 12px; background: var(--bg-content); border: 1px solid var(--hairline); border-radius: var(--radius-xl); }
  .framed figcaption { display: flex; gap: 10px; padding: 0 4px 10px; }
  .framed figcaption span { color: var(--accent-fg); }
  .framed :global(.shot) { border-radius: var(--radius); box-shadow: none; border-color: var(--hairline); }
  .narrow-shot { max-width: 560px; justify-self: end; }

  .toast {
    position: absolute; right: -16px; bottom: -18px; display: flex; align-items: center; gap: 12px;
    padding: 10px 12px; border-radius: var(--radius-lg); background: var(--bg-elevated); color: var(--text-2);
    box-shadow: var(--shadow);
  }
  .bar { display: block; height: 7px; border-radius: 4px; background: var(--border-strong); }
  .keys { display: inline-flex; gap: 3px; margin-left: auto; }
  .keys kbd { font-size: 11px; }

  .terminal { border-radius: var(--radius); border: 1px solid var(--hairline); background: var(--stage); overflow: hidden; }
  .term-bar { display: flex; gap: 6px; padding: 12px 14px; border-bottom: 1px solid var(--hairline); }
  .term-bar span { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
  .terminal pre { margin: 0; padding: 20px; overflow-x: auto; font-size: 13px; line-height: 1.75; color: var(--text-2); }
  .terminal .p { color: var(--text-3); }
  .terminal .ok { color: var(--accent-fg); }

  /* ------------------------------------------------------------ Bento */
  .bento {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px;
    background: var(--hairline); border: 1px solid var(--hairline); border-radius: var(--radius-xl); overflow: hidden;
  }
  .tile { grid-column: span 2; display: flex; flex-direction: column; gap: 6px; padding: 24px; background: var(--bg); }
  .tile-1 { grid-column: span 4; }
  .tile p { margin: 0; font-size: var(--fs-sm); line-height: 1.55; color: var(--text-3); }
  .vig { margin-bottom: 18px; padding: 14px; border: 1px solid var(--hairline); border-radius: var(--radius-lg); background: var(--bg-content); }
  .row { display: flex; align-items: center; gap: 12px; height: 32px; padding: 0 10px; border-radius: var(--radius); }
  .row.is-sel { background: var(--bg-selected); box-shadow: inset 2px 0 0 var(--accent); }
  .row .bar { flex: none; }

  .vig-graph { display: grid; grid-template-columns: 64px 1fr; gap: 4px; }
  .vig-graph .lanes { width: 64px; height: 160px; }
  .vig-graph path { fill: none; stroke-width: 2.5; }
  .vig-graph circle { stroke: var(--bg-content); stroke-width: 2.5; }
  .vig-graph .sha { font: 400 var(--fs-xs)/1 var(--mono); color: var(--text-3); }

  .vig-palette { padding: 8px; }
  .pal-input { display: flex; align-items: center; gap: 3px; height: 36px; padding: 0 10px; margin-bottom: 6px; border-bottom: 1px solid var(--hairline); }
  .pal-input kbd { font-size: 11px; }
  .caret { width: 1.5px; height: 16px; margin-left: 8px; background: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .vig-diff { padding: 8px 0; font: 400 var(--fs-xs)/1 var(--mono); }
  .dl { display: flex; align-items: center; gap: 10px; height: 24px; padding: 0 12px; color: var(--text-3); }
  .dl > span:first-child { width: 10px; }
  .dl.add { background: var(--add-bg); color: var(--green); }
  .dl.del { background: var(--del-bg); color: var(--red); }
  .dl.add .bar { background: var(--add-strong); }
  .dl.del .bar { background: var(--del-strong); }
  .dl.is-staged { box-shadow: inset 2px 0 0 var(--green); }

  .more { margin: 24px 0 0; font-size: var(--fs-sm); }

  /* ------------------------------------------------------------ Duo, pricing, FAQ */
  .duo { display: grid; grid-template-columns: 1fr 1fr; }
  .duo > * + * { border-left: 1px solid var(--hairline); }
  .duo h2 { margin-bottom: 14px; }
  .duo p { margin: 0; }

  .price-wrap { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 64px; align-items: center; }
