---
import { PRODUCT_NAME } from '../config';
import LegalPage from '../components/legal/LegalPage.astro';
import { CONFIRM, CONTACT_EMAIL, LICENSOR, LICENSOR_COUNTRY, REFUND_DAYS, SECURITY_SUBJECT } from '../components/legal/legal';

const topics = [
  { subject: 'Support', title: 'Help with the app', body: `Bugs, crashes, questions about a feature. Tell us your macOS version and ${PRODUCT_NAME} version (${PRODUCT_NAME} → About).` },
  { subject: 'Licence', title: 'Licences and orders', body: 'Lost key, moving to a new Mac, invoices, or a wrong charge. Include the email you bought with.' },
  { subject: 'Refund', title: 'Refunds', body: `Within ${REFUND_DAYS} days of purchase, no questions asked. See the refund policy for details.` },
  { subject: 'Press', title: 'Press and business', body: 'Reviews, interviews, partnerships and buying several licences at once.' },
];
---
<LegalPage
  title={`Contact · ${PRODUCT_NAME}`}
  heading="Contact"
  description={`Support, licence, press and business contacts for ${PRODUCT_NAME}. One inbox, read by the person who builds the app.`}
  ogTheme="light"
>
  <div class="legal-card">
    <h2>Email</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}><strong>{CONTACT_EMAIL}</strong></a></p>
    <p>We reply within 2 business days, usually sooner. Put one of the subjects below in your subject line so it reaches the right pile.</p>
  </div>

  <div class="legal-table-scroll">
    <table>
      <thead><tr><th>Subject</th><th>For</th></tr></thead>
      <tbody>
        {topics.map((t) => (
          <tr>
            <td><a href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(t.subject)}`}>{t.subject}</a></td>
            <td><strong>{t.title}.</strong> {t.body}</td>
          </tr>
        ))}
        <tr>
          <td><a href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(SECURITY_SUBJECT)}`}>{SECURITY_SUBJECT}</a></td>
          <td><strong>Security issues.</strong> Please read the <a href="/security">security page</a> first and don't post details publicly.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="self-serve">Quicker answers</h2>
  <ul>
    <li><a href="/licence">Licence help</a>: find your key again, activate, or move to another Mac.</li>
    <li><a href="/refunds">Refund policy</a>, <a href="/terms">terms of sale</a> and <a href="/privacy">privacy policy</a>.</li>
    <li><a href="/docs">Docs</a> and <a href="/shortcuts">keyboard shortcuts</a>.</li>
  </ul>

  <h2 id="who">Who you're talking to</h2>
  <p>
    {PRODUCT_NAME} is made by {LICENSOR}, an independent developer based in {LICENSOR_COUNTRY}.
    Postal address: <span class="legal-placeholder">{CONFIRM}</span>
  </p>
  <p>
    Orders are processed by Polar, our merchant of record, which also handles payment questions, tax invoices and receipts.
    You can reach us about any of those too.
  </p>
</LegalPage>
