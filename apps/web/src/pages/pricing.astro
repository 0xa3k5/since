---
import { PRICE_LATER, PRICE_NOW, PRODUCT_NAME } from '../config';
import Base from '../layouts/Base.astro';
import PlanCard from '../components/commerce/PlanCard.astro';
import Faq from '../components/commerce/Faq.astro';
import '../components/commerce/commerce.css';

const faq = [
  {
    q: 'Is it really a one-time payment?',
    a: `<p>Yes. You pay once and get every future version of ${PRODUCT_NAME} for macOS. No renewals, no paid upgrades, no subscription.</p>`,
  },
  {
    q: 'What happens when the trial ends?',
    a: `<p>${PRODUCT_NAME} stays open in read-only mode. You can still browse history, diffs and search, but anything that changes a repository (commit, rebase, reset, push) waits until you enter a licence key. Nothing is deleted, and your repositories are untouched.</p>`,
  },
  {
    q: 'Does it work offline?',
    a: `<p>Yes. ${PRODUCT_NAME} checks your licence with Polar now and then when you're online. Between checks it keeps working fully offline for weeks at a time.</p><p>The check sends your licence key and an activation ID, never your code or anything about your repositories. The trial itself is tracked on your Mac, with no server check.</p>`,
  },
  {
    q: 'I got a new Mac. How do I move my licence?',
    a: `<p>Remove the old Mac in the Polar customer portal, then enter your key on the new one. It works even if the old Mac is gone. <a href="/licence#devices">Step-by-step guide</a>.</p>`,
  },
  {
    q: 'Will the price go up?',
    a: `<p>Yes. $${PRICE_NOW} is the launch price, and ${PRODUCT_NAME} will cost $${PRICE_LATER} later. We'll say so on this page before it changes. If you buy at $${PRICE_NOW}, you never pay again: every future update is included.</p>`,
  },
  {
    q: 'How do VAT and sales tax work?',
    a: `<p>Polar is our merchant of record. It sells ${PRODUCT_NAME} to you, works out the VAT or sales tax for your country, collects it and sends you the receipt. Prices on this site are in USD before tax; the checkout shows any tax before you pay.</p>`,
  },
  {
    q: 'Do I need an account?',
    a: `<p>Not in ${PRODUCT_NAME}. There's no login in the app, now or later. After you buy, your licence key arrives by email. To manage your Macs or find your key again, you sign in to Polar's customer portal with a one-time code sent to your purchase email.</p>`,
  },
  {
    q: 'Buying for a team?',
    a: `<p>Each developer needs their own licence.</p>`,
  },
  {
    q: 'I lost my licence key.',
    a: `<p>You can see it any time in the Polar customer portal. <a href="/licence#resend">Here's how to get it back</a>.</p>`,
  },
];
---
<Base
  title={`Pricing: one payment, lifetime updates · ${PRODUCT_NAME}`}
  description={`$${PRICE_NOW} launch price, going to $${PRICE_LATER} later. One payment, lifetime updates, no subscription. 14-day free trial with no account.`}
  ogTheme="dark"
>
  <div class="wrap cm-page">
    <header class="cm-head">
      <p class="eyebrow">Pricing</p>
      <h1>Pay once. Get every update.</h1>
      <p class="lede">One plan, one price, no subscription. Try every feature free for 14 days before you decide.</p>
    </header>

    <div class="pricing-top">
      <PlanCard />

      <div class="pricing-promises">
        <div>
          <h2>Try it free for 14 days</h2>
          <p>Every feature, no account, no credit card. When the trial ends, {PRODUCT_NAME} stays open in read-only mode until you buy a licence.</p>
        </div>
        <div>
          <h2>Lifetime updates</h2>
          <p>Every future version of {PRODUCT_NAME} for macOS is included. No renewals, no paid upgrades, no subscription, ever.</p>
        </div>
        <div>
          <h2>Your licence moves with you</h2>
          <p>Got a new Mac? Move your licence to it any time from the <a href="/licence#devices">customer portal</a>.</p>
        </div>
        <div>
          <h2>30-day money-back guarantee</h2>
          <p>If {PRODUCT_NAME} isn't for you, ask for a full refund within 30 days of purchase. No questions asked.</p>
        </div>
      </div>
    </div>

    <div class="cm-section">
      <Faq items={faq} heading="Pricing questions" />
    </div>
  </div>
</Base>

<style>
  .pricing-top { display: grid; grid-template-columns: minmax(0, 440px) minmax(0, 1fr); gap: 48px; align-items: start; }
  .pricing-promises { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 32px; padding-top: 8px; }
  .pricing-promises h2 { font-size: 17px; margin: 0 0 6px; letter-spacing: -0.01em; }
  .pricing-promises p { margin: 0; color: var(--text-2); font-size: 15px; }
  @media (max-width: 900px) {
    .pricing-top { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .pricing-promises { grid-template-columns: 1fr; }
  }
</style>
