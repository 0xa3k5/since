---
// Claims follow the website plan's gates (AK-34 §3.6): only what is merged in main. No speed claims,
// undo history is unlimited (AK-51), keyboard copy says "every commit action is a single key".
import { PRODUCT_NAME, DOWNLOAD_URL, REPO_URL } from '../config';
import Base from '../layouts/Base.astro';
import AppShot from '../components/landing/AppShot.astro';
import Kbd from '../components/content/Kbd.astro';
import AppleGlyph from '../components/AppleGlyph.astro';
import CatchUp from '../components/landing/CatchUp.astro';
import Review from '../components/landing/Review.astro';
import MergePlan from '../components/landing/MergePlan.astro';
import StackPreview from '../components/landing/previews/StackPreview.astro';
import '../components/landing/landing.css';

// Each feature shows its capture in the site's theme.
import map from '../assets/features/map-dark.webp';
import mapLight from '../assets/features/map-light.webp';
import quick from '../assets/features/quick-dark.webp';
import quickLight from '../assets/features/quick-light.webp';
import rewrite from '../assets/features/rewrite-dark.webp';
import rewriteLight from '../assets/features/rewrite-light.webp';
import undo from '../assets/features/undo-dark.webp';
import undoLight from '../assets/features/undo-light.webp';
import commit from '../assets/features/commit-dark.webp';
import commitLight from '../assets/features/commit-light.webp';
import palette from '../assets/features/palette-dark.webp';
import paletteLight from '../assets/features/palette-light.webp';
import stashes from '../assets/features/stashes-dark.webp';
import stashesLight from '../assets/features/stashes-light.webp';

// Part 1 reuses the home page's sections (their ids), then the Stacks section.
const landing = [['catch-up', 'Since'], ['review', 'Review'], ['merge', 'Merge plan'], ['stacks', 'Stacks']];

const sections = [
  {
    id: 'map',
    eyebrow: 'The map',
    title: 'Your whole history, live',
    body: `The map draws every branch, tag and remote branch as a line of history you can read at a glance. It refreshes the moment anything changes on disk, from ${PRODUCT_NAME} or from your terminal.`,
    points: [
      ['Move through commits', ['↓'], ['↑']],
      ['Show or hide the detail panel', ['Space']],
      ['Search subjects, authors, refs and SHAs', ['⌘', 'F'], ['/']],
      ['Jump to HEAD', ['H']],
    ],
    shot: [map, mapLight, 'The map: a commit graph with branch, tag and remote labels, and the detail panel for the selected commit'],
  },
  {
    id: 'quick-view',
    eyebrow: 'Quick View',
    title: 'Read a commit without leaving the keyboard',
    body: 'Press Return on any commit to open its files and diffs full height. Step through the files, then press Escape to land back where you were.',
    points: [
      ['Open Quick View', ['↵']],
      ['Next or previous file', ['↓'], ['↑']],
      ['Back to the map', ['Esc']],
    ],
    shot: [quick, quickLight, 'Quick View: the file list of a commit next to its diff'],
  },
  {
    id: 'edit-history',
    eyebrow: 'Edit history in place',
    title: 'Every commit action is a single key',
    body: 'Select a commit and press one key. Reword, squash or fixup into its parent, split it by lines, swap it with its parent, delete it, rebase onto it, merge it, cherry-pick or revert it. No editor opens and no todo list to edit.',
    points: [
      ['Edit message', ['E']],
      ['Squash or fixup with parent', ['S'], ['F']],
      ['Split by lines into several commits', ['⇧', 'S']],
      ['Delete commit', ['⌫']],
      ['Rebase onto, merge, cherry-pick, revert', ['R'], ['M'], ['P'], ['V']],
      ['Create a branch or tag here', ['B'], ['T']],
    ],
    shot: [rewrite, rewriteLight, 'The commit menu, listing each action with its single-key shortcut'],
  },
  {
    id: 'undo',
    eyebrow: 'Undo and redo',
    title: 'Undo every change with ⌘Z',
    body: 'Every change to branches, tags and HEAD is recorded: rebase, reset, merge, commit, amend, cherry-pick, deleting a branch. So are the actions that throw work away, like discarding files or lines, a hard reset or dropping a stash. Undo puts it all back, and the history survives a restart.',
    points: [
      ['Undo', ['⌘', 'Z']],
      ['Redo', ['⇧', '⌘', 'Z']],
      ['See every step and preview a restore', ['⌘', '4']],
    ],
    foot: 'There is no limit on how far back you can go. Pushes change a remote, so they can’t be undone locally; Since asks before a force push.',
    shot: [undo, undoLight, 'After a fixup, a toast offers Undo and the toolbar undo button is active'],
  },
  {
    id: 'staging',
    eyebrow: 'Commit',
    title: 'Stage exactly the lines you mean',
    body: 'Stage or discard a whole file, a hunk or single lines. Click a line to select it, shift-click for a range. Amend the last commit with a checkbox, and commit with ⌘Return.',
    points: [
      ['Commit view', ['⌘', '2']],
      ['Stage or unstage the selected file', ['↵']],
      ['Commit', ['⌘', '↵']],
    ],
    foot: 'Discarding files, hunks or lines is undoable too.',
    shot: [commit, commitLight, 'The Commit view with three lines selected in a diff and a Stage lines button'],
  },
  {
    id: 'palette',
    eyebrow: 'Command menu',
    title: 'Everything is a few keystrokes away',
    body: 'Press ⌘K and type. Commands, views, branches to check out, refs and commits are all in one list, each with its shortcut next to it.',
    points: [
      ['Open the command menu', ['⌘', 'K']],
    ],
    link: ['/shortcuts', 'See every keyboard shortcut'],
    shot: [palette, paletteLight, 'The command menu filtered to push commands, with their shortcuts'],
  },
];

const tiles = [
  { title: 'Conflicts', body: 'A banner shows the merge, rebase or cherry-pick in progress with Continue and Abort. Resolve each file in the built-in 3-way merge editor, or take ours or theirs. Choosing a side is undoable.', keys: [['⌥', '⌘', 'M']] },
  { title: 'Worktrees', body: 'Add a worktree, switch the window to it or open it in a new one, lock and remove it. Other worktrees’ branches are marked on the graph.', keys: [['⌘', '7'], ['⌥', '⌘', 'N'], ['⌥', '⌘', 'W']] },
  { title: 'File history and blame', body: 'Every commit that touched a file, following renames, next to a blame of the selected version. Click a line to find its commit on the map.', keys: [['⇧', '⌘', 'H']] },
  { title: 'Submodules and LFS', body: 'See each submodule’s status, update them and open one in its own window. LFS files are detected and badged, and Since warns when git-lfs is missing.', keys: [['⌥', '⌘', 'B'], ['⌥', '⌘', 'U'], ['⌥', '⌘', 'F']] },
  { title: 'Your diff and merge tools', body: 'Open the selected file in the difftool or mergetool set in your git config.', keys: [['⇧', '⌘', 'D'], ['⇧', '⌘', 'M']] },
  { title: 'Right identity', body: 'Before you commit, Since checks your email against the identity this clone usually commits with and your own rules per remote, and offers a one-click fix.', keys: [['⌥', '⌘', 'I']] },
  { title: 'AI commit messages, opt-in', body: 'Off until you pick a provider: Claude Code or Codex CLI that you already use, or Ollama on your Mac. Before the first send you see exactly what goes out.', keys: [['⌥', '⌘', 'G']] },
  { title: 'Remotes', body: 'Fetch, pull and push from the keyboard, force-push with lease after a confirmation, push tags, and open the repository on its hosting site.', keys: [['⇧', '⌘', 'F'], ['⇧', '⌘', 'L'], ['⇧', '⌘', 'P']] },
  { title: 'Stashes, reflog, config', body: 'Stash everything, only staged changes, selected files or selected lines. Apply, pop and drop are undoable. Browse the reflog and edit git config, each one view away.', keys: [['⌘', '3'], ['⌘', '5'], ['⌘', '6']] },
  { title: 'Uses your git', body: `${PRODUCT_NAME} runs the git already on your Mac, with your config, hooks and credential helper. Your repository stays a normal git repository.` },
  { title: 'Light and dark', body: 'Both themes are designed with the same care. Follow the system, or pick one.', keys: [['⌃', '⌘', 'T']] },
  { title: 'Made for the Mac', body: 'Native menus, several windows at once, Open in Finder or Terminal for the current repository, and a daily check for updates.', keys: [['⇧', '⌘', 'N']] },
];

---
<Base
  title={`Features: land your agents' work, edit Git from the keyboard · ${PRODUCT_NAME}`}
  description="See what your agents merged since your checkpoint, review the whole change and merge ready PRs in a conflict-free order. Plus a full keyboard Git client: one-key history edits, line staging and ⌘Z for everything."
>
  <div class="lp fp">
    <section class="hero wrap" aria-labelledby="fp-h">
      <p class="kicker">Features</p>
      <h1 id="fp-h">Land agents' work. <span class="soft">Then keep a complete Git client.</span></h1>
      <p class="lede">{PRODUCT_NAME} reads the branches and PRs your agents open and helps you land them. Under it is a Git client you drive from the keyboard, where ⌘Z takes back anything local.</p>
      <nav class="jump" aria-label="On this page">
        {landing.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        <span class="jump-sep" aria-hidden="true"></span>
        {sections.map((s) => <a href={`#${s.id}`}>{s.eyebrow}</a>)}
        <a href="#more">More</a>
      </nav>
    </section>

    <div class="wrap part"><h2 class="part-h">Landing agents' work</h2></div>
    <CatchUp />
    <Review />
    <MergePlan />
    <section class="s wrap rule" id="stacks" aria-labelledby="stacks-h">
      <div class="feat">
        <div class="copy">
          <h2 id="stacks-h">Stacks. <span class="soft">One piece of work, start to finish.</span></h2>
          <p>A stack is a chain of PRs, each built on the one below. {PRODUCT_NAME} keeps it together everywhere it shows up.</p>
        </div>
        <StackPreview />
        <div class="facts3">
          <div><h4>Review</h4><p>One header over its parts, each noting the PR it's built on.</p></div>
          <div><h4>Merge plan</h4><p>One row, merged bottom to top in one step.</p></div>
          <div><h4>Since</h4><p>A merged stack is one item. Open it to read the parts, bottom first.</p></div>
        </div>
      </div>
    </section>

    <div class="wrap part rule"><h2 class="part-h">Still a complete Git client</h2></div>
    {sections.map((s, i) => (
      <section class:list={['s', 'wrap', 'rule', i === 0 ? 'stage' : i % 2 ? 'side' : 'side flip']} id={s.id} aria-labelledby={`${s.id}-h`}>
        <div class="feat">
          <div class="copy">
            <h2 id={`${s.id}-h`}>{s.eyebrow}. <span class="soft">{s.title}.</span></h2>
            <p>{s.body}</p>
            {i > 0 && (
              <ul>
                {s.points.map(([label, ...groups]) => (
                  <li><span>{label}</span><span class="combo">{(groups as string[][]).map((g) => <Kbd keys={g} />)}</span></li>
                ))}
              </ul>
            )}
            {s.foot && <p class="foot">{s.foot}</p>}
            {s.link && <p class="foot"><a href={s.link[0]}>{s.link[1]} →</a></p>}
          </div>
          <div class="halo"><AppShot dark={s.shot[0] as ImageMetadata} light={s.shot[1] as ImageMetadata} alt={s.shot[2] as string} eager={i === 0} class={i === 0 ? 'fade-out' : ''} /></div>
          {i === 0 && (
            <div class="facts3 facts4">
              {s.points.map(([label, ...groups]) => (
                <div><h4>{label}</h4><p class="combo">{(groups as string[][]).map((g) => <Kbd keys={g} />)}</p></div>
              ))}
            </div>
          )}
        </div>
      </section>
    ))}

    <section class="s wrap rule" id="more" aria-labelledby="more-h">
      <div class="more-head">
        <h2 id="more-h">And the rest of the day-to-day.</h2>
      </div>
      <div class="rest">
        {tiles.map((t) => (
          <article>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
            {t.keys && <p class="combo">{t.keys.map((k) => <Kbd keys={k} />)}</p>}
          </article>
        ))}
      </div>
      <div class="rest-shot halo"><AppShot dark={stashes} light={stashesLight} class="fade-out" alt="The Stashes view with two saved stashes" /></div>
      <p class="more-links"><a href="/changelog">See what has shipped</a> · <a href="/shortcuts">All keyboard shortcuts</a></p>
    </section>

    <section class="close fp-close" aria-labelledby="fp-cl-h">
      <div class="wrap">
        <h2 id="fp-cl-h">Try it on your own repositories.</h2>
        <p class="lede">Free and open source, no account. macOS 12 or later.</p>
        <div class="cta-row"><a class="btn btn-primary" href={DOWNLOAD_URL}><AppleGlyph />Download for Mac</a><a class="btn" href={REPO_URL}>View source</a></div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Features page: the landing page's rhythm (landing.css), with one capture per feature in the site's theme. */
  .fp .hero { padding-bottom: 110px; }
  .kicker { margin: 0 auto 18px; font-size: 15px; color: var(--text-3); }
  .jump { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 34px; }
  .jump a { font-size: 13.5px; color: var(--text-3); border: 1px solid var(--line); border-radius: 999px; padding: 5px 12px; text-decoration: none; transition: color .15s, border-color .15s; }
  .jump a:hover { color: var(--text); border-color: var(--line-strong); }
  .jump-sep { width: 1px; margin: 4px 6px; background: var(--line-strong); }
  /* The two group headings; the section under each drops its own rule and most of its top space. */
  .part { padding-top: 120px; }
  .fp .part + :global(.s) { padding-top: 56px; border-top: 0; }
  .fp .part-h { margin: 0; font-size: 15px; font-weight: var(--fw-medium); color: var(--accent-fg); }
  #stacks .feat { grid-template-columns: 1fr; gap: 56px; }
  #stacks .copy p { color: var(--text-3); max-width: 42rem; }
  .jump a:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }

  .fp h2 { font-size: clamp(32px, 3.8vw, 48px); }
  .fp section[id] { scroll-margin-top: 64px; }

  /* The first feature: centred stage, the capture wide and fading into the page, keys below. */
  .stage .feat { grid-template-columns: 1fr; gap: 64px; }
  .stage .copy { text-align: center; }
  .stage .copy h2 { margin: 0 auto; max-width: 20ch; }
  .stage .copy p { margin: 20px auto 0; max-width: 42rem; color: var(--text-3); text-wrap: balance; }

  /* The rest alternate sides; the text stays put while the capture scrolls past. */
  .side .feat { align-items: center; }
  .side .copy p { color: var(--text-3); }
  .flip .feat { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .flip .copy { order: 2; }
  .fp :is(.side, .stage) .feat li { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .fp :is(.side, .stage) .feat li::before { content: none; }
  .combo { display: inline-flex; flex-wrap: wrap; gap: 8px; }
  .fp :global(.keys) { display: inline-flex; gap: 3px; }
  .fp :global(.keys-or) { font-size: 12px; color: var(--text-4); margin: 0 3px; }
  .facts3 .combo { margin-top: 2px; }
  .copy .foot { margin-top: 18px; font-size: 14px; color: var(--text-4); }
  .copy .foot a { color: var(--accent-fg); }

  .more-head h2 { max-width: 22ch; }
  .rest { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 64px; border-top: 1px solid var(--line); }
  .rest article { padding: 26px 28px 30px 0; border-bottom: 1px solid var(--line); }
  .rest article:not(:nth-child(3n + 1)) { padding-left: 28px; border-left: 1px solid var(--line); }
  .rest p { margin: 8px 0 0; font-size: 15px; color: var(--text-3); }
  .rest .combo { margin-top: 14px; }
  .rest-shot { margin-top: 72px; }
  .more-links { margin: 40px 0 0; font-size: 15px; }
  .more-links a { color: var(--text-2); }

  .fp-close { padding-bottom: 150px; }

  @media (max-width: 860px) {
    .flip .feat { grid-template-columns: 1fr; }
    .flip .copy { order: 0; }
    .rest { grid-template-columns: 1fr; }
    .rest article:not(:nth-child(3n + 1)) { padding-left: 0; border-left: 0; }
  }
  @media (min-width: 861px) and (max-width: 1100px) {
    .rest { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .rest article:not(:nth-child(3n + 1)) { padding-left: 0; border-left: 0; }
    .rest article:nth-child(2n) { padding-left: 28px; border-left: 1px solid var(--line); }
  }
  @media (max-width: 720px) {
    .kicker, .stage .copy h2, .stage .copy p { margin-left: 0; margin-right: 0; }
    .jump { justify-content: flex-start; }
    .stage .copy { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) { .jump a { transition: none; } }
</style>
