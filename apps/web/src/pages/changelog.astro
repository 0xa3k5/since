---
// Built from src/content/changelog/*.md: one file per merged change, grouped by version, newest first.
// No dates are shown (no-dates rule); `merged` only orders entries within a group.
import { getCollection, render } from 'astro:content';
import { PRODUCT_NAME, SHOW_PRICING } from '../config';
import BetaCopy from '../components/BetaCopy.astro';
import Base from '../layouts/Base.astro';
import '../components/content/content.css';
import '../components/landing/landing.css';

/** Versions that have shipped. Until a version is listed here it shows as "In development". */
const RELEASED: string[] = [];
const KINDS = ['Added', 'Improved', 'Fixed', 'Behind the scenes'] as const;

const cmp = (a: string, b: string) => {
  const pa = a.split('.').map(Number), pb = b.split('.').map(Number);
  for (let i = 0; i < 3; i++) if ((pa[i] ?? 0) !== (pb[i] ?? 0)) return (pb[i] ?? 0) - (pa[i] ?? 0);
  return 0;
};
const entries = await getCollection('changelog');
const versions = await Promise.all(
  [...new Set(entries.map((e) => e.data.version))].sort(cmp).map(async (version) => ({
    version,
    released: RELEASED.includes(version),
    kinds: await Promise.all(KINDS.map(async (kind) => ({
      kind,
      items: await Promise.all(entries
        .filter((e) => e.data.version === version && e.data.kind === kind)
        .sort((a, b) => b.data.merged.getTime() - a.data.merged.getTime() || a.id.localeCompare(b.id))
        .map(async (e) => ({ id: e.id, ...e.data, Content: (await render(e)).Content }))),
    }))).then((k) => k.filter((x) => x.items.length)),
  })),
);
const anchor = (v: string) => v.replaceAll('.', '-');
const count = (v: (typeof versions)[number]) => v.kinds.reduce((n, k) => n + k.items.length, 0);
---
<Base
  title={`Changelog · ${PRODUCT_NAME}`}
  description={`What's new in every ${PRODUCT_NAME} release.${SHOW_PRICING ? ' All updates are free for every licence holder.' : ''}`}
  ogTheme="dark"
>
  <div class="lp cl">
    <section class="hero wrap" aria-labelledby="cl-h">
      <p class="kicker">Changelog</p>
      <h1 id="cl-h">What’s new. <span class="soft">Every change, newest first.</span></h1>
      <p class="lede">Every change to {PRODUCT_NAME}, newest first.{SHOW_PRICING && ' Updates are free for every licence holder, for life.'}</p>
      {versions.length > 1 && (
        <nav class="jump" aria-label="Releases">
          {versions.map((v) => <a href={`#${anchor(v.version)}`}>{v.version}</a>)}
        </nav>
      )}
    </section>

    {versions.map((v) => (
      <section class="s wrap rule cl-version" id={anchor(v.version)} aria-labelledby={`v-${anchor(v.version)}`}>
        <header class="cl-meta">
          <h2 id={`v-${anchor(v.version)}`}><a href={`#${anchor(v.version)}`}>{v.version}</a></h2>
          <span class={`cl-badge${v.released ? '' : ' dev'}`}>{v.released ? 'Released' : 'In development'}</span>
          <ul class="cl-tally" aria-label={`${count(v)} changes`}>
            {v.kinds.map((k) => <li><a href={`#${anchor(v.version)}-${k.kind.toLowerCase().replaceAll(' ', '-')}`}><span>{k.kind}</span><span class="n">{k.items.length}</span></a></li>)}
          </ul>
        </header>
        <div class="cl-groups">
          {v.kinds.map((k) => (
            <div class="cl-kind" id={`${anchor(v.version)}-${k.kind.toLowerCase().replaceAll(' ', '-')}`}>
              <h3><span class={`dot${k.kind === 'Added' ? ' on' : ''}`} aria-hidden="true"></span>{k.kind}</h3>
              {k.items.map((e) => (
                <article class="cl-entry" id={e.id}>
                  <h4><a href={`#${e.id}`}>{e.title}</a></h4>
                  <div class="prose">{SHOW_PRICING ? <e.Content /> : <BetaCopy><e.Content /></BetaCopy>}</div>
                </article>
              ))}
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  /* Changelog: the landing page's rhythm (landing.css). One ruled section per release: version and
     status stay put on the left while its grouped entries scroll on the right. */
  .cl .hero { padding-bottom: 110px; }
  .kicker { margin: 0 auto 18px; font-size: 15px; color: var(--text-3); }
  .jump { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 34px; }
  .jump a { font: 500 13px var(--mono); color: var(--text-3); border: 1px solid var(--line); border-radius: 999px; padding: 5px 12px; text-decoration: none; transition: color .15s, border-color .15s; }
  .jump a:hover { color: var(--text); border-color: var(--line-strong); }

  .cl-version { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 72px; align-items: start; scroll-margin-top: 64px; }
  .cl-meta { position: sticky; top: 96px; }
  .cl .cl-meta h2 { font: 500 clamp(40px, 4.6vw, 56px)/1 var(--mono); letter-spacing: -0.04em; }
  .cl-meta h2 a { text-decoration: none; }
  .cl-badge { display: inline-flex; margin-top: 18px; padding: 3px 10px; border-radius: 999px; font-size: 13px; color: var(--text-3); border: 1px solid var(--line-strong); }
  .cl-badge.dev { color: var(--accent-fg); background: var(--accent-soft); border-color: transparent; }
  .cl-tally { list-style: none; margin: 32px 0 0; padding: 0; border-top: 1px solid var(--line); font-size: 14px; }
  .cl-tally a { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); color: var(--text-3); text-decoration: none; transition: color .15s; }
  .cl-tally a:hover { color: var(--text); }
  .cl-tally .n { font-family: var(--mono); font-variant-numeric: tabular-nums; color: var(--text-4); }

  .cl-kind { scroll-margin-top: 96px; }
  .cl-kind + .cl-kind { margin-top: 64px; }
  .cl .cl-kind h3 { display: flex; align-items: center; gap: 10px; padding-bottom: 14px; border-bottom: 1px solid var(--line); font-size: 15px; color: var(--text-3); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-4); }
  .dot.on { background: var(--accent); }
  .cl-entry { padding: 26px 0 28px; border-bottom: 1px solid var(--line); scroll-margin-top: 96px; }
  .cl-entry h4 { margin: 0; font: 500 20px/1.3 var(--display); letter-spacing: -0.01em; color: var(--text); }
  .cl-entry h4 a { text-decoration: none; }
  .cl-entry h4 a:hover { color: var(--accent-fg); }
  .cl-entry .prose { max-width: 62ch; font-size: 16px; color: var(--text-3); }
  .cl-entry .prose :global(p) { max-width: none; color: inherit; }
  .cl-entry .prose > :global(:first-child) { margin-top: 10px; }
  .cl-entry .prose > :global(:last-child) { margin-bottom: 0; }

  @media (max-width: 860px) {
    .cl-version { grid-template-columns: 1fr; gap: 40px; }
    .cl-meta { position: static; }
  }
  @media (max-width: 720px) {
    .kicker { margin-left: 0; margin-right: 0; }
    .jump { justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .jump a, .cl-tally a { transition: none; } }
</style>
