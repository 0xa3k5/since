---
import { PRODUCT_NAME } from '../config';
---
<a class="logo" href="/" aria-label={`${PRODUCT_NAME} home`}>
  <svg class="logo-mark" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="7" fill="var(--accent)" />
    <path d="M4 14A10 10 0 0 1 24 14Z" fill="var(--accent-text)" />
    <path d="M28 16A10 10 0 0 1 8 16Z" fill="var(--brand-cream)" />
  </svg>
  <span class="logo-word">{PRODUCT_NAME}</span>
</a>
