---
// A real capture of the app in the landing page's window frame, in the site's theme. The PNGs in
// src/assets/app/ come from apps/desktop/e2e/site-shots.capture.js; Astro serves them as webp.
// With a light twin, both render and global.css .only-light/.only-dark hides one (a hidden lazy image
// is never fetched). Eager: only the dark one gets high priority. `tabs` draws the window's repository tab
// strip above the capture (the first is active), so it follows the site theme without a capture of its own.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props { dark: ImageMetadata; light?: ImageMetadata; alt: string; eager?: boolean; tabs?: string[]; class?: string; }
const { dark, light, alt, eager = false, tabs, class: cls = '' } = Astro.props;
const img = { sizes: '(max-width: 900px) 100vw, 1100px', format: 'webp', quality: 82, loading: eager ? 'eager' : 'lazy' } as const;
---
<figure class:list={['app', 'app-shot', 'lit-shot', cls]}>
  {tabs && <div class="app-tabs" aria-hidden="true">{tabs.map((t, i) => <span class:list={{ on: i === 0 }}>{t}</span>)}</div>}
  {light && <Image class="only-light" src={light} alt={alt} widths={[720, 1080, 1440, light.width]} {...img} />}
  <Image class={light ? 'only-dark' : undefined} src={dark} alt={alt} widths={[720, 1080, 1440, dark.width]} {...img} fetchpriority={eager ? 'high' : undefined} />
</figure>
