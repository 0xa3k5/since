---
// A product screenshot in both themes. The site's .only-light / .only-dark rules show the one that
// matches the active theme, including the manual toggle (a <picture media> source can't follow that).
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

export interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  /** Rendered widths in px; the browser picks one from `sizes`. */
  widths: number[];
  sizes: string;
  /** The hero shot loads eagerly; everything below the fold loads lazily. */
  eager?: boolean;
  class?: string;
}

const { light, dark, alt, widths, sizes, eager = false, class: className } = Astro.props;
const common = {
  alt,
  widths,
  sizes,
  formats: ['avif', 'webp'],
  fallbackFormat: 'webp',
  quality: 80,
  loading: eager ? 'eager' : 'lazy',
  decoding: 'async',
} as const;
---
<div class:list={['shot', className]}>
  <Picture src={light} pictureAttributes={{ class: 'only-light' }} {...common} />
  <Picture src={dark} pictureAttributes={{ class: 'only-dark' }} {...common} />
</div>

<style>
  .shot {
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    background: var(--bg-content);
    box-shadow: var(--shot-shadow);
    overflow: hidden;
  }
  .shot :global(img) { display: block; width: 100%; height: auto; }
</style>
