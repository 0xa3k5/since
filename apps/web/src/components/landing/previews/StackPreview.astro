---
import Stage from './Stage.astro';
import Icon from './Icon.astro';
// [number, title, the row's stack note (review-rows.js stackNote)], top of the stack first.
const parts: [number, string, string][] = [
  [271, 'Merge a stack in one step', 'on #264 · 3 of 3'],
  [264, 'Group stacks in Review', 'on #257 · 2 of 3'],
  [257, 'Add the stack model', 'Stack · 1 of 3'],
];
---
<Stage h={188} hSm={182} label="Review: a stack of three pull requests under one header, each part noting the one it is built on">
  <div class="pv-st">
    <div class="pv-st-head"><Icon name="chevronDown" class="pv-file-chev" /><span class="pv-cu-num">Stack #257 → #271</span></div>
    {parts.map(([n, title, note]) => (
      <div class="pv-st-row"><span class="pv-cu-num">#{n}</span><span class="pv-cu-title">{title}</span><span class="pv-st-note">{note}</span></div>
    ))}
    <div class="pv-st-next"><span class="pv-cu-num">#219</span><span class="pv-cu-title quiet">Tighten the toolbar spacing</span></div>
  </div>
</Stage>
