---
// The app's own icons (icon() in apps/desktop/renderer/ui.js): same paths, viewBox 16, stroke 1.4, currentColor.
const P = {
  check: '<path d="m3 8.5 3 3 7-7"/>',
  chevron: '<path d="m6 4 4 4-4 4"/>',
  chevronLeft: '<path d="m10 4-4 4 4 4"/>',
  chevronDown: '<path d="m4 6 4 4 4-4"/>',
  chevronUp: '<path d="m4 10 4-4 4 4"/>',
  warning: '<path d="M8 2.5 14 13H2z"/><path d="M8 6.5v3M8 11.2v.1"/>',
};
const { name, size = 12, class: cls } = Astro.props;
---
<svg class:list={['pv-icon', cls]} width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={P[name]} />
