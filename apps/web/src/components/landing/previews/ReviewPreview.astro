---
import Stage from './Stage.astro';
---
<Stage label="Review: a stuck pull request with the reason on its row, CI failing on test/unit, above one that is ready to merge">
  <div class="pv-rv-group">Stuck</div>
  <div class="pv-rv-row on"><span class="pv-rv-dot stuck"></span>
    <div><div class="pv-rv-title"><span class="n">#214</span>Retry failed fetches</div><div class="pv-rv-why">CI failing · test/unit</div></div><span class="pv-rv-age">2h</span></div>
  <div class="pv-dim">
    <div class="pv-rv-group quiet">Ready to merge</div>
    <div class="pv-rv-row"><span class="pv-rv-dot"></span>
      <div><div class="pv-rv-title"><span class="n">#216</span>Medium weights in the sidebar</div><div class="pv-rv-sub">agent/web-301 · 3 commits</div></div><span class="pv-rv-age">40m</span></div>
  </div>
</Stage>
