---
import { DOWNLOAD_URL, REPO_URL } from '../../config';
import AppleGlyph from '../AppleGlyph.astro';
---
<section class="close" aria-labelledby="cl-h">
  <div class="wrap">
    <h2 id="cl-h">Your agents keep shipping. <span class="soft">Now you can keep up.</span></h2>
    <p class="lede">Try it on your own repositories. Free, open source, no account.</p>
    <div class="cta-row"><a class="btn btn-primary" href={DOWNLOAD_URL}><AppleGlyph />Download for Mac</a><a class="btn" href={REPO_URL}>View source</a></div>
    <p class="small">Beta · macOS 12+</p>
  </div>
  <svg class="converge" viewBox="0 0 1200 380" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <filter id="lp-soft" x="-20%" y="-200%" width="140%" height="500%"><feGaussianBlur stdDeviation="10"/></filter>
      <linearGradient id="lp-infade" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".22" stop-color="#fff"/></linearGradient>
      <linearGradient id="lp-outfade" gradientUnits="userSpaceOnUse" x1="620" x2="1200" y1="0" y2="0"><stop offset="0" style="stop-color:var(--accent)"/><stop offset=".7" style="stop-color:var(--accent);stop-opacity:.6"/><stop offset="1" style="stop-color:var(--accent);stop-opacity:0"/></linearGradient>
      <mask id="lp-inmask"><rect width="1200" height="380" fill="url(#lp-infade)"/></mask>
    </defs>
    <g mask="url(#lp-inmask)">
      <path id="lp-cv0" class="cl" style="stroke:var(--lane-1)" d="M0 30 C 320 30, 330 190, 620 190"/><path id="lp-cv1" class="cl" style="stroke:var(--lane-3)" d="M0 70 C 320 70, 330 190, 620 190"/><path id="lp-cv2" class="cl" style="stroke:var(--lane-4)" d="M0 105 C 320 105, 330 190, 620 190"/><path id="lp-cv3" class="cl" style="stroke:var(--text-4)" d="M0 150 C 320 150, 330 190, 620 190"/><path id="lp-cv4" class="cl" style="stroke:var(--lane-1)" d="M0 185 C 320 185, 330 190, 620 190"/><path id="lp-cv5" class="cl" style="stroke:var(--lane-3)" d="M0 230 C 320 230, 330 190, 620 190"/><path id="lp-cv6" class="cl" style="stroke:var(--lane-4)" d="M0 270 C 320 270, 330 190, 620 190"/><path id="lp-cv7" class="cl" style="stroke:var(--lane-1)" d="M0 300 C 320 300, 330 190, 620 190"/><path id="lp-cv8" class="cl" style="stroke:var(--lane-3)" d="M0 335 C 320 335, 330 190, 620 190"/>
      <g class="dot"><circle r="3" style="fill:var(--lane-1)"><animateMotion dur="4.1s" begin="0.5s" repeatCount="indefinite"><mpath href="#lp-cv0"/></animateMotion></circle><circle r="3" style="fill:var(--lane-3)"><animateMotion dur="4.8s" begin="0.2s" repeatCount="indefinite"><mpath href="#lp-cv1"/></animateMotion></circle><circle r="3" style="fill:var(--lane-4)"><animateMotion dur="4.6s" begin="1.1s" repeatCount="indefinite"><mpath href="#lp-cv2"/></animateMotion></circle><circle r="3" style="fill:var(--text-4)"><animateMotion dur="3.5s" begin="1.5s" repeatCount="indefinite"><mpath href="#lp-cv3"/></animateMotion></circle><circle r="3" style="fill:var(--lane-1)"><animateMotion dur="3.5s" begin="1.3s" repeatCount="indefinite"><mpath href="#lp-cv4"/></animateMotion></circle><circle r="3" style="fill:var(--lane-3)"><animateMotion dur="3.6s" begin="0.3s" repeatCount="indefinite"><mpath href="#lp-cv5"/></animateMotion></circle><circle r="3" style="fill:var(--lane-4)"><animateMotion dur="4.3s" begin="2.5s" repeatCount="indefinite"><mpath href="#lp-cv6"/></animateMotion></circle><circle r="3" style="fill:var(--lane-1)"><animateMotion dur="3.7s" begin="0.7s" repeatCount="indefinite"><mpath href="#lp-cv7"/></animateMotion></circle><circle r="3" style="fill:var(--lane-3)"><animateMotion dur="4.8s" begin="2.8s" repeatCount="indefinite"><mpath href="#lp-cv8"/></animateMotion></circle></g>
    </g>
    <path class="bloom" d="M620 190 H 1200" style="stroke:url(#lp-outfade)"/>
    <path class="mainline" d="M620 190 H 1200" style="stroke:url(#lp-outfade)"/>
    <circle cx="620" cy="190" r="7" style="fill:var(--accent)"/>
  </svg>
</section>
