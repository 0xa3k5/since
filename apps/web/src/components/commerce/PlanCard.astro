---
// The single plan. Wording follows AK-32 §6 with the owner's later decisions: no date, Polar, a Mac limit.
import { BUY_URL, PRICE_LATER, PRICE_NOW, PRODUCT_NAME } from '../../config';
import { MACS_PER_LICENCE } from './links';

const perks = [
  'Every feature, now and in the future',
  `Use it on up to ${MACS_PER_LICENCE} of your Macs`,
  '14-day free trial, no account, no credit card',
];
---
<div class="plan">
  <p class="plan-name">{PRODUCT_NAME} for macOS</p>
  <p class="plan-price"><span class="cur">$</span>{PRICE_NOW}</p>
  <p class="plan-launch"><strong>Launch price</strong>, going to ${PRICE_LATER} later.</p>
  <p class="plan-terms">One payment. Lifetime updates. No subscription.</p>
  <div class="plan-cta">
    <a class="btn btn-primary" href={BUY_URL}>Buy {PRODUCT_NAME}</a>
    <a class="btn btn-secondary" href="/download">Download free trial</a>
  </div>
  <ul class="plan-perks">
    {perks.map((p) => <li>{p}</li>)}
    <li><a href="/refunds">30-day money-back guarantee</a></li>
  </ul>
  <p class="plan-fine">
    Prices in USD. VAT or sales tax is added at checkout where applicable. Payments are handled by Polar,
    our reseller and merchant of record.
  </p>
</div>

<style>
  .plan {
    max-width: 440px; padding: 28px; border: 1px solid var(--border-strong); border-radius: var(--radius-lg);
    background: var(--bg-content); box-shadow: var(--shadow-sm);
    border-top: 3px solid var(--accent);
  }
  .plan-name { margin: 0; font-weight: 600; color: var(--text-2); font-size: 14px; }
  .plan-price { margin: 10px 0 0; font-size: 64px; font-weight: 700; line-height: 1; letter-spacing: -0.04em; color: var(--text); }
  .cur { font-size: 32px; vertical-align: 22px; margin-right: 2px; color: var(--text-2); font-weight: 600; }
  .plan-launch { margin: 12px 0 0; color: var(--text-2); }
  .plan-launch strong { color: var(--accent-fg); font-weight: 600; }
  .plan-terms { margin: 4px 0 0; color: var(--text); font-weight: 560; }
  .plan-cta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .plan-cta .btn { flex: 1 1 auto; height: 38px; font-size: 15px; }
  .plan-perks { list-style: none; margin: 24px 0 0; padding: 20px 0 0; border-top: 1px solid var(--hairline); display: grid; gap: 10px; font-size: 15px; color: var(--text-2); }
  .plan-perks li { position: relative; padding-left: 26px; }
  .plan-perks li::before {
    content: ""; position: absolute; left: 2px; top: 6px; width: 12px; height: 7px;
    border-left: 2px solid var(--green); border-bottom: 2px solid var(--green); transform: rotate(-45deg);
  }
  .plan-fine { margin: 20px 0 0; font-size: 13px; color: var(--text-3); }
</style>
