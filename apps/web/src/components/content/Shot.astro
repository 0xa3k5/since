---
// An app screenshot in both themes. The site's theme picks which one shows (global.css .only-light/.only-dark).
import type { ImageMetadata } from 'astro';

export interface Props { light: ImageMetadata; dark: ImageMetadata; alt: string; eager?: boolean; }
const { light, dark, alt, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---
<figure class="shot">
  <img class="only-light" src={light.src} width={light.width} height={light.height} alt={alt} loading={loading} decoding="async" />
  <img class="only-dark" src={dark.src} width={dark.width} height={dark.height} alt={alt} loading={loading} decoding="async" />
</figure>
