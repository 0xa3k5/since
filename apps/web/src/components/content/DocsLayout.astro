---
import { PRODUCT_NAME } from '../../config';
import Base from '../../layouts/Base.astro';
import { DOCS } from './docs-nav';
import './content.css';

export interface Props { title: string; description: string; ogTheme?: 'light' | 'dark'; }
const { title, description, ogTheme = 'dark' } = Astro.props;
const here = Astro.url.pathname.replace(/\.html$/, '');
const i = DOCS.findIndex((d) => d.href === here);
const prev = DOCS[i - 1], next = DOCS[i + 1];
---
<Base title={`${title} · ${PRODUCT_NAME} docs`} description={description} ogTheme={ogTheme}>
  <div class="wrap content-page docs">
    <nav class="docs-nav" aria-label="Docs">
      <a class="docs-home" href="/docs">Docs</a>
      <ul>
        {DOCS.map((d) => <li><a href={d.href} aria-current={d.href === here ? 'page' : undefined}>{d.title}</a></li>)}
        <li><a href="/shortcuts">Keyboard shortcuts</a></li>
      </ul>
    </nav>
    <article class="docs-body">
      <p class="eyebrow">Docs</p>
      <h1>{title}</h1>
      <div class="prose"><slot /></div>
      <nav class="docs-pager" aria-label="Previous and next">
        {prev ? <a href={prev.href}><span>Previous</span>{prev.title}</a> : <span />}
        {next && <a class="next" href={next.href}><span>Next</span>{next.title}</a>}
      </nav>
    </article>
  </div>
</Base>

<style>
  .docs { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 56px; align-items: start; }
  .docs-nav { position: sticky; top: 92px; font-size: 14px; }
  .docs-home { display: block; margin-bottom: 10px; font-weight: 600; color: var(--text); text-decoration: none; }
  .docs-nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .docs-nav li a { display: block; padding: 5px 10px; margin-left: -10px; border-radius: var(--radius); color: var(--text-3); text-decoration: none; }
  .docs-nav li a:hover { color: var(--text); background: var(--bg-hover); }
  .docs-nav li a[aria-current="page"] { color: var(--text); background: var(--bg-active); }
  .docs-body h1 { font-size: clamp(30px, 4vw, 40px); margin: 10px 0 8px; }
  .docs-body :global(.prose > p:first-child) { font-size: 18px; color: var(--text-2); }
  .docs-pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--border); }
  .docs-pager a { display: grid; gap: 2px; text-decoration: none; color: var(--text); font-weight: 560; }
  .docs-pager a span { font-size: 13px; font-weight: 400; color: var(--text-3); }
  .docs-pager .next { text-align: right; margin-left: auto; }
  @media (max-width: 860px) {
    .docs { grid-template-columns: 1fr; gap: 24px; }
    .docs-nav { position: static; }
    .docs-nav ul { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  }
</style>
