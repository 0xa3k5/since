---
import { HEADER_NAV } from '../routes';
import Logo from './Logo.astro';
import AppleGlyph from './AppleGlyph.astro';

const current = Astro.url.pathname.replace(/\.html$/, '');
---
<div class="site-head" data-site-head>
  <header class="wrap nav">
    <div class="nav-brand"><Logo /><span class="beta-pill">Beta</span></div>
    <nav class="nav-links" aria-label="Main">
      {HEADER_NAV.map((r) => (
        <a class="nav-link" href={r.href} aria-current={current === r.href || current.startsWith(r.href + '/') ? 'page' : undefined}>{r.label}</a>
      ))}
    </nav>
    <a class="btn btn-sm" href="/download"><AppleGlyph />Download</a>
  </header>
</div>

<script>
  // A hairline under the header once the page has scrolled.
  const head = document.querySelector('[data-site-head]');
  if (head) {
    const sync = () => head.classList.toggle('scrolled', scrollY > 10);
    addEventListener('scroll', sync, { passive: true });
    sync();
  }
</script>
