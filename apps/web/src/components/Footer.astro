---
import { COPYRIGHT, LICENCE_NAME, LICENCE_URL, PRODUCT_NAME } from '../config';
import { FOOTER_NAV } from '../routes';
import Logo from './Logo.astro';
import ThemeSwitch from './ThemeSwitch.astro';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand"><Logo /><span>· made for Mac</span></div>
      <div class="footer-cols">
        {FOOTER_NAV.map((col) => (
          <nav aria-label={col.title}>
            <h2>{col.title}</h2>
            <ul>
              {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="footer-legal">
      <ThemeSwitch />
      <p>{COPYRIGHT} · <a href={LICENCE_URL}>{LICENCE_NAME}</a></p>
      <p>Git™ is a trademark of Software Freedom Conservancy. {PRODUCT_NAME} is not affiliated with or endorsed by the Git project.</p>
    </div>
  </div>
</footer>
