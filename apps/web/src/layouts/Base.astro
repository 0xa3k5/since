---
import '@gitsince/tokens/tokens.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { ANALYTICS_ENABLED } from '../config';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export type Props = SeoProps;
---
<!doctype html>
<!-- The theme follows the system, like the app. -->
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <Seo {...Astro.props} />
    <!-- Match --bg in each theme's tokens; a meta tag can't read a CSS variable. -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf7f4">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#080707">
    <link rel="preload" href="/fonts/outfit-latin-wght.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="sitemap" href="/sitemap-index.xml">
    {ANALYTICS_ENABLED && <Fragment><!-- Analytics provider goes here once chosen (website plan D7). --></Fragment>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
